{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copyloom",
  "version": "0.1.38",
  "identifier": "io.clipapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Copyloom",
        "width": 1280,
        "height": 820,
        "minWidth": 700,
        "minHeight": 520,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "devtools": false,
        "generalAutofillEnabled": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Personlig clipboard-historik",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi"
      }
    }
  }
}
