// copyloom.app on Cloudflare Workers: the public folder as static files, with no server code.
// Publish with `npm run deploy` in this folder (after `npx wrangler login` once).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copyloom",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "copyloom.app", "custom_domain": true }],
  // Only copyloom.app; no second public address on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
